# ==============================================================================
# Evolution VTT Backend — Variáveis de Ambiente (EXEMPLO / PLACEHOLDERS)
# ==============================================================================
# Copie para `.env` localmente (nunca versione `.env` real no Git).

# Profile ativo:
# - local : inicia sem banco de dados (enquanto PostgreSQL local não estiver provisionado)
# - dev   : desenvolvimento integrado ao PostgreSQL + Flyway
# - prod  : produção (PostgreSQL + Flyway obrigatórios, hardening completo)
SPRING_PROFILES_ACTIVE=local

# Servidor HTTP
SERVER_PORT=8080

# Identificação básica não sensível
APP_VERSION=0.0.1-SNAPSHOT
APP_ENVIRONMENT=local

# Banco de dados PostgreSQL (obrigatório nos profiles `dev` e `prod`)
DB_URL=jdbc:postgresql://localhost:5432/evolutionvtt
DB_USERNAME=evolutionvtt_user
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

# Logging estruturado (ADR-014)
# Opções nativas Spring Boot: ecs | logstash | gelf | (vazio para texto legível)
LOG_STRUCTURED_FORMAT=ecs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
