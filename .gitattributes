# Git Attributes — Evolution VTT
# Padroniza quebras de linha (LF) e tratamento de arquivos binários entre sistemas operacionais.

* text=auto eol=lf

# Documentação e configuração
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Backend (Java / SQL)
*.java text eol=lf
*.sql text eol=lf
*.gradle text eol=lf
*.kts text eol=lf

# Frontend (Web / TypeScript / CSS)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf

# Infraestrutura e scripts
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
mvnw text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jar binary
*.zip binary
